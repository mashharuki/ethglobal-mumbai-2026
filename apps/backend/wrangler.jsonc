{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-05",
  "durable_objects": {
    "bindings": [
      { "name": "AUTH_STORE", "class_name": "AuthStore" },
      { "name": "SEARCH_COORDINATOR", "class_name": "SearchCoordinator" },
      {
        "name": "SIMULATION_DATE_REQUESTS",
        "class_name": "SimulationDateRequestStore"
      }
    ]
  },
  "migrations": [
    { "tag": "auth-store-v1", "new_sqlite_classes": ["AuthStore"] },
    {
      "tag": "search-coordinator-v1",
      "new_sqlite_classes": ["SearchCoordinator"]
    },
    {
      "tag": "simulation-date-requests-v1",
      "new_sqlite_classes": ["SimulationDateRequestStore"]
    }
  ]
  // "compatibility_flags": [
