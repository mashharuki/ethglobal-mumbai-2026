        <mxCell id="secret" value="&lt;div style=&quot;font-size:16px;line-height:1.48;font-weight:normal&quot;&gt;照合証明・真偽は当事者間だけ。&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.48;font-weight:normal&quot;&gt;相手の秘密を一つの端末に集めない。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#2563EB;fontSize=16;fontFamily=Hiragino Sans;align=left;verticalAlign=top;spacing=16;arcSize=10;shape=text;spacing=0;rounded=0;" vertex="1" parent="fe">
