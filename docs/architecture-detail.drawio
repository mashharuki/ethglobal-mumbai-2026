        <mxCell id="subtitle" value="&lt;div style=&quot;font-size:20px;line-height:1.48;font-weight:normal&quot;&gt;秘密は各端末に保持。公開登録は ENSv2 × Arkiv、資金の確定は Ethereum Sepolia。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#52647B;fontSize=20;fontFamily=Hiragino Sans;align=left;verticalAlign=top;spacing=16;arcSize=10;shape=text;spacing=0;rounded=0;" vertex="1" parent="1">
