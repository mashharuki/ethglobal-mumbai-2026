        <mxCell id="third" value="&lt;div style=&quot;font-size:16px;line-height:1.48;font-weight:bold&quot;&gt;第三者 C の画面：仮名の公開登録だけ&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#14243B;fontSize=16;fontFamily=Hiragino Sans;align=left;verticalAlign=top;spacing=16;arcSize=10;shape=text;spacing=0;rounded=0;" vertex="1" parent="fe">
          <mxGeometry x="25" y="385" width="450" height="30" as="geometry" />
        </mxCell>
        <mxCell id="anon" value="&lt;div style=&quot;font-size:19px;font-weight:bold;margin-bottom:9px&quot;&gt;アプリ読取：Anon-RPCを標準に&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.48;font-weight:normal&quot;&gt;Sepoliaの読取経路は下段①。失敗は表示して再試行。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ABC5EF;strokeWidth=1.5;fontColor=#2563EB;fontSize=14;fontFamily=Hiragino Sans;align=left;verticalAlign=top;spacing=16;arcSize=10;" vertex="1" parent="fe">
          <mxGeometry x="25" y="435" width="450" height="90" as="geometry" />
        </mxCell>
        <mxCell id="wallet" value="&lt;div style=&quot;font-size:19px;font-weight:bold;margin-bottom:9px&quot;&gt;資金操作：本人の署名と証明&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.48;font-weight:normal&quot;&gt;チェーンへの送信は下段②。秘密noteは端末で復元。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D2BC97;strokeWidth=1.5;fontColor=#A25D09;fontSize=14;fontFamily=Hiragino Sans;align=left;verticalAlign=top;spacing=16;arcSize=10;" vertex="1" parent="fe">
          <mxGeometry x="25" y="555" width="450" height="95" as="geometry" />
        </mxCell>
        <mxCell id="behead" value="&lt;div style=&quot;font-size:21px;line-height:1.48;font-weight:bold&quot;&gt;02  BACKEND  /  apps/backend&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#087F8C;fontSize=21;fontFamily=Hiragino Sans;align=left;verticalAlign=top;spacing=16;arcSize=10;shape=text;spacing=0;rounded=0;" vertex="1" parent="be">
          <mxGeometry x="25" y="20" width="450" height="35" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;div style=&quot;font-size:19px;font-weight:bold;margin-bottom:9px&quot;&gt;同一オリジン BFF / Hono on Workers&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.48;font-weight:normal&quot;&gt;署名認証・入力検証・公開登録API&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.48;font-weight:normal&quot;&gt;ENSの権限とArkivの現行版を照合&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.48;font-weight:normal&quot;&gt;平文の趣味・相性結果は受け取らない&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CCFC5;strokeWidth=1.5;fontColor=#087F8C;fontSize=16;fontFamily=Hiragino Sans;align=left;verticalAlign=top;spacing=16;arcSize=10;" vertex="1" parent="be">
          <mxGeometry x="25" y="70" width="450" height="140" as="geometry" />
        </mxCell>
        <mxCell id="search" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:9px&quot;&gt;検索・招待用 Durable Object&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.48;font-weight:normal&quot;&gt;リース・暗号文配送・再送を直列化&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.48;font-weight:normal&quot;&gt;両noteの拘束確定後だけ部屋資格を発行&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CCFC5;strokeWidth=1.5;fontColor=#087F8C;fontSize=15;fontFamily=Hiragino Sans;align=left;verticalAlign=top;spacing=16;arcSize=10;" vertex="1" parent="be">
          <mxGeometry x="25" y="260" width="450" height="105" as="geometry" />
        </mxCell>
        <mxCell id="room" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:9px&quot;&gt;P2：部屋ごとの Durable Object&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.48;font-weight:normal&quot;&gt;参加資格・revision・actionId・手番&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF6FF;strokeColor=#B49ACF;strokeWidth=1.5;fontColor=#7851B8;fontSize=15;fontFamily=Hiragino Sans;align=left;verticalAlign=top;spacing=16;arcSize=10;dashed=1;dashPattern=7 5;" vertex="1" parent="be">
          <mxGeometry x="25" y="405" width="450" height="75" as="geometry" />
        </mxCell>
        <mxCell id="model" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:9px&quot;&gt;P2：外部 World Model&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.48;font-weight:normal&quot;&gt;共有テーマ・場面・匿名A/Bの選択 → 次場面&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.48;font-weight:normal&quot;&gt;プロフィール・仮名・資金は渡さない&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF6FF;strokeColor=#B49ACF;strokeWidth=1.5;fontColor=#7851B8;fontSize=15;fontFamily=Hiragino Sans;align=left;verticalAlign=top;spacing=16;arcSize=10;dashed=1;dashPattern=7 5;" vertex="1" parent="1">
