        <mxCell id="title" value="&lt;div style=&quot;font-size:34px;line-height:1.48;font-weight:bold&quot;&gt;PRIVATE DATING  /  システムアーキテクチャ&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#14243B;fontSize=34;fontFamily=Hiragino Sans;align=left;verticalAlign=top;spacing=16;arcSize=10;shape=text;spacing=0;rounded=0;" vertex="1" parent="1">
