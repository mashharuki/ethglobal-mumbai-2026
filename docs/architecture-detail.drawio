        <mxCell id="b" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:9px&quot;&gt;独立端末 B&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.48;font-weight:normal&quot;&gt;React / Vite / PWA&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.48;font-weight:normal&quot;&gt;プロフィール・秘密鍵&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.48;font-weight:normal&quot;&gt;本人のnote / 復元情報&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.48;font-weight:normal&quot;&gt;Noir：証明生成・検証&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.48;font-weight:normal&quot;&gt;Kohaku / ウォレット&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ABC5EF;strokeWidth=1.5;fontColor=#2563EB;fontSize=15;fontFamily=Hiragino Sans;align=left;verticalAlign=top;spacing=16;arcSize=10;" vertex="1" parent="fe">
