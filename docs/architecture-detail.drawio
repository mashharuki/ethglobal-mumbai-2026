        </mxCell>
        <mxCell id="publichead" value="&lt;div style=&quot;font-size:20px;line-height:1.48;font-weight:bold&quot;&gt;03  PUBLIC SERVICES / CONTRACTS&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#14243B;fontSize=20;fontFamily=Hiragino Sans;align=left;verticalAlign=top;spacing=16;arcSize=10;shape=text;spacing=0;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="1380" y="180" width="460" height="35" as="geometry" />
        </mxCell>
        <mxCell id="ens" value="&lt;div style=&quot;font-size:21px;font-weight:bold;margin-bottom:9px&quot;&gt;ENSv2 / Ethereum Sepolia&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.48;font-weight:normal&quot;&gt;サブネームの発行・実解決&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.48;font-weight:normal&quot;&gt;所有権と更新権を別々に確認&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.48;font-weight:normal&quot;&gt;ENS-V2：仮名を登録認可に利用&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F4FF;strokeColor=#BBB3E3;strokeWidth=1.5;fontColor=#7851B8;fontSize=16;fontFamily=Hiragino Sans;align=left;verticalAlign=top;spacing=16;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1380" y="235" width="460" height="145" as="geometry" />
        </mxCell>
        <mxCell id="arkiv" value="&lt;div style=&quot;font-size:21px;font-weight:bold;margin-bottom:9px&quot;&gt;Arkiv / 現行テストネット&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.48;font-weight:normal&quot;&gt;仮名・登録版・コミットメント・登録証明&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.48;font-weight:normal&quot;&gt;公開登録の実書込 → 索引反映 → 実読取&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.48;font-weight:normal&quot;&gt;秘密値・ペア・相性結果を保存しない&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.48;font-weight:normal&quot;&gt;ARKIV-APP：画面が実データを読む&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9F6;strokeColor=#99CDBB;strokeWidth=1.5;fontColor=#087F8C;fontSize=15;fontFamily=Hiragino Sans;align=left;verticalAlign=top;spacing=16;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1380" y="430" width="460" height="155" as="geometry" />
        </mxCell>
        <mxCell id="funds" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:9px&quot;&gt;スマートコントラクト / Sepolia&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.48;font-weight:normal&quot;&gt;apps/contract · Hardhat / Solidity&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.48;font-weight:normal&quot;&gt;CircleのテストUSDC・EURCを預託&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.48;font-weight:normal&quot;&gt;両noteの原子的拘束 → 精算・返却・受領&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.48;font-weight:normal&quot;&gt;資金の確定状態はチェーンが正本&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.48;font-weight:normal&quot;&gt;仮名ペア・申告内容を公開しない&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.48;font-weight:normal&quot;&gt;独自の秘匿精算・回復は実証前&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EC;strokeColor=#DFC292;strokeWidth=1.5;fontColor=#A25D09;fontSize=16;fontFamily=Hiragino Sans;align=left;verticalAlign=top;spacing=16;arcSize=10;" vertex="1" parent="1">
