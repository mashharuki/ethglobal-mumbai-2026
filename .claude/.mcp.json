{
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "pnpm dlx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    },
    "serena": {
      "type": "stdio",
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context=jb-copilot-plugin"
      ]
    },
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": ["serve", "--mcp"]
    },
    "lism-css": {
      "type": "stdio",
      "command": "pnpm dlx",
      "args": ["-y", "@lism-css/mcp"]
    }
  }
}